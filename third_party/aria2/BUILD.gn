# aria2 (https://aria2.github.io, GPL-2.0-or-later) is Falcon's download
# engine. It runs as a sidecar process next to the browser binary and is
# driven over JSON-RPC; nothing links against it.

if (is_win) {
  copy("aria2c") {
    sources = [ "win/aria2c.exe" ]
    outputs = [ "$root_out_dir/aria2c.exe" ]
  }
}
