# Bitwarden CLI (https://github.com/bitwarden/clients, GPL-3.0) is Falcon's
# vault sidecar: `bw serve` exposes the unlocked vault on 127.0.0.1 and Falcon
# Passwords reads/writes logins through it. Separate process, not linked.
# The binary is not in git: run D:/falcon/tools/fetch-sidecars.ps1.

if (is_win) {
  copy("bitwarden_cli") {
    sources = [ "win/bw.exe" ]
    outputs = [ "$root_out_dir/bw.exe" ]
  }
}
