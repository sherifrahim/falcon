--- a/build/config/locales.gni
+++ b/build/config/locales.gni
@@ -172,6 +172,7 @@ extended_locales = [
   "zh-HK",
   "zu",
 ]
+import("//brave/build/config/locales.gni") extended_locales -= brave_extended_locales_exclusions
 
 # Chrome locales not on Android.
 # These locales have not yet been tested yet. Specifically, AOSP has not been
@@ -296,3 +297,29 @@ if (is_apple) {
     }
   }
 }
+
+import("//brave/build/config/falcon_locales.gni")
+if (falcon_pak_locales != []) {
+  platform_pak_locales = []
+  platform_pak_locales = falcon_pak_locales
+  locales_with_pseudolocales = []
+  locales_with_pseudolocales = falcon_pak_locales
+  locales_without_pseudolocales = []
+  locales_without_pseudolocales = falcon_pak_locales
+  if (is_android) {
+    android_bundle_locales_as_resources = []
+    android_bundle_locales_as_resources =
+        falcon_android_bundle_locales_as_resources
+  }
+
+  # Consumers subtract |extended_locales| from |platform_pak_locales|; keep
+  # only the extended locales that are still shipped so that stays valid.
+  _falcon_extended_locales = []
+  foreach(_locale, extended_locales) {
+    if (filter_include(falcon_pak_locales, [ _locale ]) != []) {
+      _falcon_extended_locales += [ _locale ]
+    }
+  }
+  extended_locales = []
+  extended_locales = _falcon_extended_locales
+}
