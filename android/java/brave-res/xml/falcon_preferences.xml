<PreferenceScreen xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" >

    <PreferenceCategory
        android:key="falcon_shell_section"
        android:title="@string/falcon_shell_section" />

    <ListPreference
        android:persistent="false"
        android:key="falcon_bottom_bar_mode"
        android:title="@string/falcon_bottom_bar"
        android:dialogTitle="@string/falcon_bottom_bar"
        android:entries="@array/falcon_bottom_bar_entries"
        android:entryValues="@array/falcon_bottom_bar_values" />

    <ListPreference
        android:persistent="false"
        android:key="falcon_archive_tabs"
        android:title="@string/falcon_archive_tabs"
        android:dialogTitle="@string/falcon_archive_tabs"
        android:entries="@array/falcon_archive_entries"
        android:entryValues="@array/falcon_archive_values" />

    <PreferenceCategory
        android:key="falcon_downloads_section"
        android:title="@string/falcon_downloads_section" />

    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
        android:persistent="false"
        android:key="falcon_downloader_enabled"
        android:title="@string/falcon_downloader_enabled"
        android:summary="@string/falcon_downloader_enabled_summary" />

    <ListPreference
        android:persistent="false"
        android:key="falcon_downloader_connections"
        android:title="@string/falcon_downloader_connections"
        android:dialogTitle="@string/falcon_downloader_connections"
        android:entries="@array/falcon_downloader_connections_entries"
        android:entryValues="@array/falcon_downloader_connections_values" />

    <Preference
        android:persistent="false"
        android:key="falcon_save_to"
        android:title="@string/falcon_save_to" />

    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
        android:persistent="false"
        android:key="falcon_downloader_verify"
        android:title="@string/falcon_downloader_verify"
        android:summary="@string/falcon_downloader_verify_summary" />

    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
        android:persistent="false"
        android:key="falcon_downloader_wifi_only"
        android:title="@string/falcon_downloader_wifi_only"
        android:summary="@string/falcon_downloader_wifi_only_summary" />

    <PreferenceCategory
        android:key="falcon_look_section"
        android:title="@string/falcon_look_section" />

    <Preference
        android:fragment="org.chromium.chrome.browser.night_mode.settings.ThemeSettingsFragment"
        android:key="falcon_theme"
        android:title="@string/theme_settings"
        android:summary="@string/falcon_theme_summary" />

    <org.chromium.components.browser_ui.settings.ChromeSwitchPreference
        android:persistent="false"
        android:key="falcon_pitch_black"
        android:title="@string/falcon_pitch_black"
        android:summary="@string/falcon_pitch_black_summary" />

</PreferenceScreen>
