<!-- label-over-value tile (Limit / When done / Save to). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/falcon_bg_tile"
    android:orientation="vertical"
    android:paddingStart="12dp"
    android:paddingEnd="12dp"
    android:paddingTop="10dp"
    android:paddingBottom="12dp">

    <TextView
        android:id="@+id/falcon_tile_label"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-medium"
        android:letterSpacing="0.14"
        android:textAllCaps="true"
        android:textColor="@color/falcon_ink_3"
        android:textSize="11sp" />

    <TextView
        android:id="@+id/falcon_tile_value"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:fontFamily="monospace"
        android:maxLines="1"
        android:textColor="@color/falcon_ink"
        android:textSize="13sp"
        android:textStyle="bold" />
</LinearLayout>
