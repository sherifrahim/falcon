<!-- Downloads (mock v6 screen 4): telemetry first, text tabs, rows, capsule at the thumb. -->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/falcon_downloads_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/falcon_bg_space_downloads">

    <View
        android:layout_width="3dp"
        android:layout_height="match_parent"
        android:background="@color/falcon_accent"
        android:alpha="0.9" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingBottom="96dp">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="24dp"
            android:paddingEnd="24dp"
            android:paddingTop="20dp">

            <TextView
                android:id="@+id/falcon_downloads_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/falcon_downloads_section"
                android:textColor="@color/falcon_ink"
                android:textSize="34sp"
                android:fontFamily="sans-serif-black"
                android:letterSpacing="-0.04"
                android:includeFontPadding="false" />

            <TextView
                android:id="@+id/falcon_engine_pill"
                tools:ignore="RelativeOverlap"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_alignBaseline="@id/falcon_downloads_title"
                android:drawablePadding="8dp"
                android:fontFamily="monospace"
                android:textColor="@color/falcon_ink_2"
                android:textSize="11sp"
                android:textStyle="bold" />
        </RelativeLayout>

        <org.chromium.chrome.browser.falcon.download.ui.TelemetryView
            android:id="@+id/falcon_telemetry"
            android:layout_width="match_parent"
            android:layout_height="156dp"
            android:layout_marginStart="14dp"
            android:layout_marginEnd="14dp"
            android:layout_marginTop="14dp"
            android:background="@drawable/falcon_bg_control" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:layout_marginTop="12dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <LinearLayout
                android:id="@+id/falcon_tabs"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="horizontal" />

            <TextView
                android:id="@+id/falcon_pause_all"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:text="@string/falcon_pause_all"
                android:textColor="@color/falcon_accent"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginStart="24dp"
            android:layout_marginEnd="24dp"
            android:background="@color/falcon_hair" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/falcon_download_list"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:layout_marginTop="8dp"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:clipToPadding="false"
            android:scrollbars="none" />

        <TextView
            android:id="@+id/falcon_empty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="40dp"
            android:text="@string/falcon_downloads_empty"
            android:textColor="@color/falcon_ink_3"
            android:textSize="13sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- capsule: back · search · menu · + -->
    <LinearLayout
        android:id="@+id/falcon_capsule"
        android:layout_width="match_parent"
        android:layout_height="68dp"
        android:layout_gravity="bottom"
        android:layout_marginStart="14dp"
        android:layout_marginEnd="14dp"
        android:layout_marginBottom="18dp"
        android:background="@drawable/falcon_bg_capsule"
        android:elevation="12dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingStart="6dp"
        android:paddingEnd="6dp">

        <ImageButton
            android:id="@+id/falcon_back"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/falcon_back"
            android:src="@drawable/falcon_ic_back" />

        <LinearLayout
            android:id="@+id/falcon_search_field"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/falcon_bg_field"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="14dp"
            android:paddingEnd="10dp">

            <ImageView
                android:layout_width="18dp"
                android:layout_height="18dp"
                android:importantForAccessibility="no"
                android:src="@drawable/falcon_ic_search" />

            <EditText
                android:importantForAutofill="no"
                android:id="@+id/falcon_search"
                tools:ignore="NestedWeights"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:layout_marginStart="10dp"
                android:background="@null"
                android:hint="@string/falcon_search_downloads"
                android:imeOptions="actionSearch"
                android:inputType="text"
                android:maxLines="1"
                android:textColor="@color/falcon_ink"
                android:textColorHint="@color/falcon_ink_2"
                android:textSize="14sp" />
        </LinearLayout>

        <ImageButton
            android:id="@+id/falcon_more"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:contentDescription="@string/falcon_menu"
            android:src="@drawable/falcon_ic_menu" />

        <ImageButton
            android:id="@+id/falcon_add"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:background="@drawable/falcon_bg_accent"
            android:contentDescription="@string/falcon_new_download"
            android:src="@drawable/falcon_ic_plus"
            android:tint="@color/falcon_accent_ink" />
    </LinearLayout>
</FrameLayout>
