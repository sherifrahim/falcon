<!-- Space home header (mock v6 screen 1): space name, meta, the ambient clock. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/falcon_ntp_header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingStart="24dp"
    android:paddingEnd="24dp"
    android:paddingTop="28dp"
    android:paddingBottom="8dp">

    <TextView
        android:id="@+id/falcon_space_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:includeFontPadding="false"
        android:letterSpacing="-0.04"
        android:text="@string/falcon_space_personal"
        android:textColor="@color/falcon_ink"
        android:textSize="44sp" />

    <TextView
        android:id="@+id/falcon_space_meta"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:textColor="@color/falcon_ink_2"
        android:textSize="12sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:gravity="bottom"
        android:orientation="horizontal">

        <TextClock
            android:id="@+id/falcon_clock"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:fontFamily="sans-serif-medium"
            android:format12Hour="h:mm"
            android:format24Hour="HH:mm"
            android:includeFontPadding="false"
            android:letterSpacing="-0.05"
            android:textColor="@color/falcon_ink"
            android:textSize="56sp" />

        <TextView
            android:id="@+id/falcon_date"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="16dp"
            android:layout_marginBottom="8dp"
            android:textColor="@color/falcon_ink_2"
            android:textSize="13sp" />
    </LinearLayout>

    <!-- Greeting (serif, like the desktop home) + ambient weather on the same line. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/falcon_greeting"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:fontFamily="serif"
            android:includeFontPadding="false"
            android:textColor="@color/falcon_ink"
            android:textSize="22sp" />
        <TextView
            android:id="@+id/falcon_weather"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/falcon_bg_pill"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="6dp"
            android:paddingBottom="6dp"
            android:textColor="@color/falcon_ink"
            android:textSize="12sp"
            android:visibility="gone" />
    </LinearLayout>

    <!-- Quote of the day (same list as the desktop home). -->
    <TextView
        android:id="@+id/falcon_quote"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:fontFamily="serif"
        android:textStyle="italic"
        android:lineSpacingExtra="2dp"
        android:textColor="@color/falcon_ink_2"
        android:textSize="14sp" />
</LinearLayout>
