<!-- New download (mock v6 screen 6): hint, options, the URL field and button at the thumb. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/falcon_bg_sheet"
    android:orientation="vertical"
    android:paddingStart="18dp"
    android:paddingEnd="18dp"
    android:paddingTop="18dp"
    android:paddingBottom="20dp">

    <TextView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fontFamily="sans-serif-black"
        android:letterSpacing="-0.03"
        android:text="@string/falcon_new_download"
        android:textColor="@color/falcon_ink"
        android:textSize="20sp" />

    <TextView
        android:id="@+id/falcon_add_hint"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/falcon_new_download_hint"
        android:textColor="@color/falcon_ink_2"
        android:textSize="12.5sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <EditText
            android:importantForAutofill="no"
            android:id="@+id/falcon_add_url"
            android:layout_width="0dp"
            android:layout_height="52dp"
            android:layout_weight="1"
            android:background="@drawable/falcon_bg_field"
            android:fontFamily="monospace"
            android:hint="@string/falcon_url_hint"
            android:imeOptions="actionGo"
            android:inputType="textUri"
            android:maxLines="1"
            android:paddingStart="14dp"
            android:paddingEnd="14dp"
            android:textColor="@color/falcon_ink"
            android:textColorHint="@color/falcon_ink_3"
            android:textSize="13sp" />

        <ImageButton
            android:id="@+id/falcon_add_go"
            android:layout_width="52dp"
            android:layout_height="52dp"
            android:layout_marginStart="8dp"
            android:background="@drawable/falcon_bg_accent"
            android:contentDescription="@string/falcon_download"
            android:src="@drawable/falcon_ic_download"
            android:tint="@color/falcon_accent_ink" />
    </LinearLayout>

    <EditText
            android:importantForAutofill="no"
        android:id="@+id/falcon_add_name"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="10dp"
        android:background="@drawable/falcon_bg_field"
        android:fontFamily="monospace"
        android:hint="@string/falcon_file_name_optional"
        android:inputType="text"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/falcon_ink"
        android:textColorHint="@color/falcon_ink_3"
        android:textSize="13sp" />

    <EditText
            android:importantForAutofill="no"
        android:id="@+id/falcon_add_sha"
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:layout_marginTop="8dp"
        android:background="@drawable/falcon_bg_field"
        android:fontFamily="monospace"
        android:hint="@string/falcon_sha256_optional"
        android:inputType="textNoSuggestions"
        android:maxLines="1"
        android:paddingStart="14dp"
        android:paddingEnd="14dp"
        android:textColor="@color/falcon_ink"
        android:textColorHint="@color/falcon_ink_3"
        android:textSize="13sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/falcon_save_to"
                android:textColor="@color/falcon_ink"
                android:textSize="13.5sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:text="@string/falcon_save_to_downloads"
                android:textColor="@color/falcon_ink_2"
                android:textSize="11.5sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/falcon_hair" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/falcon_connections"
                android:textColor="@color/falcon_ink"
                android:textSize="13.5sp" />

            <TextView
                android:id="@+id/falcon_add_connections"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="monospace"
                android:textColor="@color/falcon_ink_2"
                android:textSize="11.5sp" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/falcon_hair" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="44dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:fontFamily="sans-serif-medium"
                android:text="@string/falcon_downloader_wifi_only"
                android:textColor="@color/falcon_ink"
                android:textSize="13.5sp" />

            <Switch
                android:id="@+id/falcon_add_wifi_only"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content" />
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="@color/falcon_hair" />
    </LinearLayout>

</LinearLayout>
