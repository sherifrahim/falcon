<!-- Falcon surface tokens as theme attributes, so a runtime overlay (pitch black) can swap
     them; accents, hairlines and ink stay plain colours (falcon_colors.xml). -->
<resources>
    <attr name="falconBg" format="color" />
    <attr name="falconGlassSolid" format="color" />
    <attr name="falconSurface" format="color" />
    <attr name="falconFill" format="color" />
    <attr name="falconField" format="color" />
    <attr name="falconHandle" format="color" />
    <attr name="falconSegmentIdle" format="color" />
</resources>
