<lint>
    <issue id="ExportedService" severity="ignore" />
    <issue id="DuplicateDefinition">
        <ignore regexp="chrome/android/java/res/values/colors.xml" />
    </issue>
    <issue id="StringFormatCount">
        <ignore regexp="sponsored_images_bottom_sheet_text" />
        <ignore regexp="notification_marketing" />
        <ignore regexp="renew_monthly_save" />
        <ignore regexp="wallet_swap_fees_notice" />
        <ignore regexp="processing_fee" />
    </issue>
    <issue id="WrongConstant">
        <ignore regexp="ContentSettingsType.BRAVE_CONTENT_SETTINGS_TYPES_LIST" />
    </issue>
    <!-- Falcon retires Brave surfaces one by one; their orphaned resources are expected. -->
    <issue id="UnusedResources" severity="ignore">
        <ignore regexp="brave/android/java/" />
        <ignore regexp="chrome/android/java/res/" />
        <ignore regexp="falcon_" />
        <ignore regexp="Falcon" />
    </issue>
    <!-- Falcon's Android UI: the downloader singleton holds the application context on purpose;
         the sheet/list layouts weigh their columns on purpose. -->
    <issue id="StaticFieldLeak">
        <ignore regexp="falcon/download/FalconDownloadManager.java" />
    </issue>
    <issue id="DisableBaselineAlignment">
        <ignore regexp="falcon_" />
    </issue>
    <issue id="NestedWeights">
        <ignore regexp="falcon_" />
    </issue>
    <issue id="ImpliedQuantity">
        <ignore regexp="brave/build/android/android_brave_strings_grd"/>
    </issue>

    <!-- This is inherited from upstream -->
    <issue id="DataExtractionRules">
        <ignore regexp="The attribute `android:allowBackup` is deprecated from Android 12 and higher and may be removed in future versions. Consider adding the attribute `android:dataExtractionRules` specifying an `@xml` resource which configures cloud backups and device transfers on Android 12 and higher." />
    </issue>
</lint>
