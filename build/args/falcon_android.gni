# Copyright (c) 2026 Falcon. Personal fork of Brave.
# Falcon build overrides for ANDROID output directories — the desktop strip
# (falcon.gni) made Android-safe. Imported from out/<dir>/args.gn:
#
#   import("//out/android_Release_arm64/args_generated.gni")
#   import("//brave/build/args/falcon_android.gni")
#
# Native code, WebUI bundles and JNI headers of each service below drop out of
# the build. Brave's Android Java for them stays compiled (it is referenced
# from everywhere) but is gated at its JNI boundary by the BraveConfig.ENABLE_*
# constants (android/BUILD.gn brave_config_java), so javac/R8 remove the dead
# native-facing code and nothing calls a native that is not linked. Falcon's
# policies (LoadFalconPolicies) keep the UI for them hidden either way.

# Leo / AI
enable_ai_chat = false
enable_local_ai = false

# Crypto & monetisation
enable_brave_ads = false
enable_brave_rewards = false
enable_brave_wallet = false

# Brave services
enable_brave_news = false
enable_brave_talk = false
enable_brave_vpn_v1 = false
enable_brave_vpn_v2 = false

# Telemetry-ish
enable_brave_stats_updater = false
enable_web_discovery_native = false
enable_web_discovery = false

# Field-trial / Griffin seed: never fetch from Brave (see falcon.gni).
brave_variations_server_url = "https://no-thanks.invalid/seed"

# No phone-home to Brave from the leftovers that have no build flag: webcompat reports and
# the usage ping (also off by policy) get a host that fails fast.
webcompat_report_api_endpoint = "https://no-thanks.invalid/webcompat"
brave_stats_updater_url = "https://no-thanks.invalid/usage"
