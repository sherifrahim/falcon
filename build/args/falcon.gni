# Copyright (c) 2026 Falcon. Personal fork of Brave.
# Falcon build overrides for DESKTOP output directories. Imported from
# out/<dir>/args.gn (user-editable) — not from brave_defaults.gni — because
# Brave's Android code assumes Leo/Ads/Rewards/Wallet/News/VPN exist at build
# time; Android keeps them compiled in and hides them at runtime later.
#
#   import("//out/Component/args_generated.gni")
#   import("//brave/build/args/falcon.gni")
#
# Everything here is a Brave service/product we compile OUT. Features we keep
# on purpose (do not add here): playlist, speedreader, tor, containers,
# commander, request_otr, psst, widevine, text_recognition, custom_background.

# Leo / AI
enable_ai_chat = false
enable_local_ai = false

# Crypto & monetisation
enable_brave_ads = false
enable_brave_rewards = false
enable_brave_wallet = false

# Brave services
enable_brave_news = false
enable_brave_talk = false
enable_brave_vpn_v1 = false
enable_brave_vpn_v2 = false
enable_email_aliases = false

# Telemetry-ish
enable_brave_stats_updater = false
enable_web_discovery = false

# English-only UI: 80 locale .pak files (~80 MB in the installer) stay out
# (//brave/build/config/falcon_locales.gni).
falcon_pak_locales = [
  "en-US",
  "en-GB",
]

# Field-trial / Griffin seed: never fetch from Brave. A .invalid host fails
# fast; an empty value would fall back to Google's variations server.
brave_variations_server_url = "https://no-thanks.invalid/seed"

# No phone-home to Brave from the leftovers that have no build flag: webcompat reports and
# the usage ping (also off by policy) get a host that fails fast.
webcompat_report_api_endpoint = "https://no-thanks.invalid/webcompat"
brave_stats_updater_url = "https://no-thanks.invalid/usage"

# Component updates: Brave's go-updater only answers builds with Brave's private
# services key, so every component (CRLSet, PKI metadata, Safety Tips, Widevine…)
# sat at 0.0.0.0. Chromium's own components come from Google's public server;
# Brave-only ones (adblock lists, NTP images) are replaced by public filter-list
# subscriptions seeded by browser/falcon/shields/adblock_seed.cc.
updater_prod_endpoint = "https://update.googleapis.com/service/update2/json"
updater_dev_endpoint = "https://update.googleapis.com/service/update2/json"

# Falcon never asks to send a crash report to Brave: the dialog is on for
# official desktop builds, and its only outcome is turning on Brave's crash
# upload. Reporting itself stays off via the MetricsReportingEnabled policy.
enable_crash_dialog = false

# Falcon does not ship DirectX Shader Compiler (dxcompiler.dll + dxil.dll,
# 24.7 MB of the package). Dawn then force-sets UseDXC=false and compiles WGSL
# with FXC (d3dcompiler_47.dll, already shipped), so WebGPU still works; what
# goes is the feature set gated on DXC — shader-f16, subgroups,
# subgroup-size-control, AtomicVec2uMinMax, experimental subgroup matrix — and
# shaders needing Shader Model > 5.1.
dawn_use_built_dxc = false
