import("//brave/components/common/typescript.gni")

transpile_web_ui("falcon_control_ui") {
  output_module = false
  entry_points = [ [
        "falcon_control",
        rebase_path("falcon_control.tsx"),
      ] ]

  resource_name = "falcon_control"
  imports_from = [ "//brave/components/falcon_control_ui/" ]
}

pack_web_resources("generated_resources") {
  resource_name = "falcon_control"
  output_dir = "$root_gen_dir/brave/components/falcon_control_ui/resources"
  deps = [ ":falcon_control_ui" ]
}
