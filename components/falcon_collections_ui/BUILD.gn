import("//brave/components/common/typescript.gni")

transpile_web_ui("falcon_collections_ui") {
  output_module = false
  entry_points = [ [
        "falcon_collections",
        rebase_path("falcon_collections.tsx"),
      ] ]

  resource_name = "falcon_collections"
  imports_from = [ "//brave/components/falcon_collections_ui/" ]
}

pack_web_resources("generated_resources") {
  resource_name = "falcon_collections"
  output_dir = "$root_gen_dir/brave/components/falcon_collections_ui/resources"
  deps = [ ":falcon_collections_ui" ]
}
